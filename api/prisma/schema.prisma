generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Address {
  id          String   @id // e.g., '莲麻村-中田组-001号'
  name        String
  longitude   Float
  latitude    Float
  level       String?  @default("村/网格")
  type        String?  @default("住宅")

  populations Population[]
  houses      House[]
  units       Unit[]
  facilities  Facility[]
  orders      Order[]
}

model Population {
  id          Int      @id @default(autoincrement())
  name        String
  type        String?  // e.g., '老人', '儿童', '外出', '干部', '军人'
  phone       String?
  idCard      String?  // 新增：身份证号
  gender      String?  // 新增：性别
  
  addressId   String
  address     Address  @relation(fields: [addressId], references: [id])

  disputes        DisputeRecord[]  @relation("DisputePopulations")
  floatingRecords FloatingRecord[] @relation("FloatingPopulation")
}

model House {
  id          Int      @id @default(autoincrement())
  status      String   // e.g., '危房', '民宿', '自建房'
  usage       String?  @default("自住") // 新增：房屋用途
  ownerName   String?  // 新增：产权人
  ownerPhone  String?  // 新增：产权人电话

  addressId   String
  address     Address  @relation(fields: [addressId], references: [id])

  floatingRecords FloatingRecord[]  @relation("FloatingHouse")
  inspections     HouseInspection[] @relation("InspectionHouse")
}

model Unit {
  id           Int      @id @default(autoincrement())
  name         String
  type         String?  // 新增：单位类型(如：特色餐饮、加工制造)
  legalPerson  String?  // 新增：法人/负责人
  contactPhone String?  // 新增：联系电话

  addressId    String
  address      Address  @relation(fields: [addressId], references: [id])
}

model Facility {
  id          Int      @id @default(autoincrement())
  type        String   // e.g., '消防', '监控', '垃圾'
  name        String?  // 新增：设施具体名称
  status      String?  @default("正常") // 新增：运行状态
  manager     String?  // 新增：管护责任人

  addressId   String
  address     Address  @relation(fields: [addressId], references: [id])
}

model Order {
  id          Int      @id @default(autoincrement())
  type        String
  status      String
  description String?
  source      String?  @default("网格员巡查") // 新增：隐患来源
  priority    String?  @default("中")        // 新增：优先级(高/中/低)
  handlerId   Int?
  
  addressId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  address     Address  @relation(fields: [addressId], references: [id])
}

model Config {
  id          Int      @id @default(1)
  tiandituKey String?
}

model User {
  id                  Int               @id @default(autoincrement())
  name                String
  phone               String?
  role                String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  disputes            DisputeRecord[]   @relation("DisputeMediator")
  projects            Project[]         @relation("ProjectLeader")
  supervisionTasks    SupervisionTask[] @relation("SupervisionHandler")
}

model DisputeRecord {
  id          Int          @id @default(autoincrement())
  title       String
  type        String
  content     String
  status      String
  mediatorId  Int?
  mediator    User?        @relation("DisputeMediator", fields: [mediatorId], references: [id])
  populations Population[] @relation("DisputePopulations")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Project {
  id           Int      @id @default(autoincrement())
  name         String
  investment   Float
  area         Float
  progress     String
  difficulties String?
  leaderId     Int?
  leader       User?    @relation("ProjectLeader", fields: [leaderId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model FloatingRecord {
  id           Int        @id @default(autoincrement())
  populationId Int
  population   Population @relation("FloatingPopulation", fields: [populationId], references: [id])
  houseId      Int
  house        House      @relation("FloatingHouse", fields: [houseId], references: [id])
  origin       String
  reason       String
  expireDate   DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model HouseInspection {
  id        Int      @id @default(autoincrement())
  houseId   Int
  house     House    @relation("InspectionHouse", fields: [houseId], references: [id])
  structure String
  usage     String
  hazards   String
  deadline  DateTime?
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SupervisionTask {
  id        Int      @id @default(autoincrement())
  source    String
  content   String
  deadline  DateTime
  status    String
  handlerId Int?
  handler   User?    @relation("SupervisionHandler", fields: [handlerId], references: [id])
  report    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
